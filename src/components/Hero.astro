---
import Icon from './Icon.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  subheading: string;
  image?: string;
  imageAlt?: string;
  badges?: string[];
  primary: Link;
  secondary?: Link;
  note?: { title: string; text: string };
}

const { eyebrow, heading, subheading, image, imageAlt, badges, primary, secondary, note } =
  Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="display">{heading}</h1>
      <p class="lead">{subheading}</p>
      <div class="hero-actions button-row">
        <a class="button button--primary" href={primary.href}>
          {primary.label}
          <Icon name="arrow" class="button__icon" />
        </a>
        {secondary && (
          <a class="button button--ghost" href={secondary.href}>{secondary.label}</a>
        )}
      </div>
      {badges && badges.length > 0 && (
        <ul class="hero-badges">
          {badges.map((badge) => (
            <li class="badge">
              <Icon name="check" />
              {badge}
            </li>
          ))}
        </ul>
      )}
    </div>

    {image && (
      <div class="hero-media">
        <img
          class="hero-image"
          src={image}
          alt={imageAlt ?? ''}
          width="1200"
          height="1500"
          fetchpriority="high"
          decoding="async"
        />
        {note && (
          <div class="hero-media__note">
            <strong>{note.title}</strong>
            {note.text}
          </div>
        )}
      </div>
    )}
  </div>
</section>
