---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'services'>;
  href: string;
  ctaLabel: string;
}

const { service, href, ctaLabel } = Astro.props;
const { title, summary, duration, price, image, imageAlt } = service.data;
---

<article class="card service-card">
  {image && (
    <img
      class="service-card__media"
      src={image}
      alt={imageAlt ?? ''}
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="service-card__body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="service-card__meta">
      <span>{duration}</span>
      <span class="service-card__price">{price}</span>
    </div>
    <a class="text-link" href={href}>
      {ctaLabel}
      <Icon name="arrow" />
    </a>
  </div>
</article>
