---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="page-header">
  <div class="container container--narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="display">{title}</h1>
    {text && <p class="lead">{text}</p>}
  </div>
</section>
